SG3HE"}},{"cell_type":"code","source":["RANDOM_STATE = 42\n","N_BOOTSTRAPS = 2000\n","\n","def allocation_improvement(df, budget=0.10):\n","    \"\"\"\n","    Compare tuned XGBoost and lowest-object-count allocation.\n","    Positive difference favors XGBoost.\n","    \"\"\"\n","\n","    n_selected = int(np.ceil(len(df) * budget))\n","\n","    # Select compounds using tuned XGBoost predictions\n","    xgb_selected = df.nlargest(\n","        n_selected, \"Tuned_XGBoost\"\n","    )\n","\n","    # Select compounds with lowest minimum object counts\n","    heuristic_selected = df.nsmallest(\n","        n_selected, \"Min_Object_Count\"\n","    )\n","\n","    xgb_mean = xgb_selected[\"Actual_Improvement\"].mean()\n","    heuristic_mean = heuristic_selected[\"Actual_Improvement\"].mean()\n","\n","    return xgb_mean - heuristic_mean\n","\n","\n","bootstrap_results = []\n","\n","for budget in [0.10, 0.20, 0.30]:\n","\n","    # Observed difference\n","    observed_difference = allocation_improvement(\n","        allocation_data,\n","        budget\n","    )\n","\n","    bootstrap_differences = []\n","\n","    rng = np.random.default_rng(RANDOM_STATE)\n","\n","    for i in range(N_BOOTSTRAPS):\n","\n","        # Resample compounds with replacement\n","        sample_idx = rng.choice(\n","            len(allocation_data),\n","            size=len(allocation_data),\n","            replace=True\n","        )\n","\n","        sample = allocation_data.iloc[sample_idx]\n","\n","        difference = allocation_improvement(\n","            sample,\n","            budget\n","        )\n","\n","        bootstrap_differences.append(difference)\n","\n","    # 95% percentile confidence interval\n","    ci_lower, ci_upper = np.percentile(\n","        bootstrap_differences,\n","        [2.5, 97.5]\n","    )\n","\n","    bootstrap_results.append({\n","        \"Budget\": int(budget * 100),\n","        \"Observed_Difference\": observed_difference,\n","        \"CI_Lower\": ci_lower,\n","     